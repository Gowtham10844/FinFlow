PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finflow
DB_USER=postgres
DB_PASSWORD=your_db_password
# Set to "true" for hosted Postgres that requires SSL (e.g. Render); leave "false" locally
DB_SSL=false

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173
